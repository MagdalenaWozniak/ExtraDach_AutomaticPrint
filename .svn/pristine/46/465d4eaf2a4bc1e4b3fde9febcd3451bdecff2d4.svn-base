using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace AutomaticPrint.DTO
{
    class DocumentPrintDto
    {
        public int printPar1 { get; private set; }
        public int printPar2 { get; private set; }
        public int printPar3 { get; private set; }

        public DocumentPrintDto(int printPar1, int printPar2, int printPar3)
        {
            this.printPar1 = printPar1;
            this.printPar2 = printPar2;
            this.printPar3 = printPar3;
        }
    }
}
